#!/usr/bin/env python3
"""
Keyboard Layout Indicator for LXQt panel using StatusNotifierItem (SNI).
Uses xkb-switch for keyboard layout polling.
"""

import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib
import subprocess
import signal
import sys
import os

# Layout code to display name mapping
LAYOUT_NAMES = {
    'us': 'EN',
    'ru': 'RU',
    'ua': 'UA',
    'de': 'DE',
    'fr': 'FR',
}

ICON_DIR = os.path.expanduser('~/.local/share/kb-indicator/icons')


def create_text_icon(text, size=22):
    """Create a PNG icon with text using cairo."""
    import cairo
    
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    ctx = cairo.Context(surface)
    
    ctx.set_source_rgba(0.2, 0.2, 0.2, 0.9)
    ctx.rectangle(0, 0, size, size)
    ctx.fill()
    
    ctx.set_source_rgb(1, 1, 1)
    ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    ctx.set_font_size(size * 0.65)
    
    extents = ctx.text_extents(text)
    x = (size - extents.width) / 2 - extents.x_bearing
    y = (size - extents.height) / 2 - extents.y_bearing
    
    ctx.move_to(x, y)
    ctx.show_text(text)
    
    return surface


def ensure_icons():
    """Pre-generate icons for all layouts."""
    os.makedirs(ICON_DIR, exist_ok=True)
    
    for code, name in LAYOUT_NAMES.items():
        icon_path = os.path.join(ICON_DIR, f'{code}.png')
        if not os.path.exists(icon_path):
            surface = create_text_icon(name)
            surface.write_to_png(icon_path)
    
    default_path = os.path.join(ICON_DIR, 'default.png')
    if not os.path.exists(default_path):
        surface = create_text_icon('??')
        surface.write_to_png(default_path)


def get_current_layout():
    """Get current keyboard layout using xkb-switch."""
    try:
        result = subprocess.run(
            ['xkb-switch', '-g'],
            capture_output=True,
            text=True,
            timeout=2
        )
        if result.returncode == 0:
            layout = result.stdout.strip().lower()
            return layout
    except Exception:
        pass
    return 'us'


class StatusNotifierItem(dbus.service.Object):
    """DBus StatusNotifierItem implementation."""
    
    ITEM_IFACE = 'org.kde.StatusNotifierItem'
    PROPERTIES_IFACE = 'org.freedesktop.DBus.Properties'
    
    def __init__(self, bus, object_path):
        dbus.service.Object.__init__(self, bus, object_path)
        self.current_layout = 'us'
        self._bus = bus
        self._object_path = object_path

        # Try registering with StatusNotifierWatcher
        if not self._try_register():
            self._watch_for_watcher()

        # Start polling
        GLib.timeout_add_seconds(1, self.poll_layout)

    def _try_register(self):
        """Attempt to register with StatusNotifierWatcher."""
        try:
            watcher = self._bus.get_object(
                'org.kde.StatusNotifierWatcher',
                '/StatusNotifierWatcher'
            )
            watcher.RegisterStatusNotifierItem(
                self._object_path,
                dbus_interface='org.kde.StatusNotifierWatcher'
            )
            return True
        except dbus.DBusException:
            return False

    def _watch_for_watcher(self):
        """Subscribe to NameOwnerChanged for watcher registration."""
        def on_name_owner_changed(name, old_owner, new_owner):
            if name == 'org.kde.StatusNotifierWatcher' and new_owner:
                self._try_register()

        self._bus.add_signal_receiver(
            on_name_owner_changed,
            signal_name='NameOwnerChanged',
            dbus_interface='org.freedesktop.DBus',
            path='/org/freedesktop/DBus'
        )
    
    def poll_layout(self):
        """Poll current layout and update if changed."""
        try:
            layout = get_current_layout()
            if layout and layout != self.current_layout:
                self.update_layout(layout)
        except Exception as e:
            print(f"Poll error: {e}", file=sys.stderr)
        return True
    
    def update_layout(self, layout_code):
        """Update current layout and emit signal."""
        self.current_layout = layout_code
        icon_file = os.path.join(ICON_DIR, f'{layout_code}.png')
        if not os.path.exists(icon_file):
            display_name = LAYOUT_NAMES.get(layout_code, layout_code.upper()[:2])
            surface = create_text_icon(display_name)
            surface.write_to_png(icon_file)
        
        self.NewIcon()
        self.NewToolTip()
    
    def cleanup(self):
        """Clean up resources."""
        pass
    
    @dbus.service.method(PROPERTIES_IFACE, in_signature='ss', out_signature='v')
    def Get(self, interface, prop):
        return self.GetAll(interface)[prop]
    
    @dbus.service.method(PROPERTIES_IFACE, in_signature='s', out_signature='a{sv}')
    def GetAll(self, interface):
        display_name = LAYOUT_NAMES.get(self.current_layout, self.current_layout.upper()[:2])
        
        return {
            'Category': 'SystemServices',
            'Id': 'kb-indicator',
            'Title': 'Keyboard Layout',
            'Status': 'Active',
            'IconName': self.current_layout,
            'IconPixmap': dbus.Array([], signature='(iiay)'),
            'OverlayIconName': '',
            'OverlayIconPixmap': dbus.Array([], signature='(iiay)'),
            'AttentionIconName': '',
            'AttentionIconPixmap': dbus.Array([], signature='(iiay)'),
            'AttentionMovieName': '',
            'ToolTip': dbus.Struct(
                ('', dbus.Array([], signature='(iiay)'), f'Layout: {display_name}', ''),
                signature='sa(iiay)ss'
            ),
            'IconThemePath': ICON_DIR,
            'Menu': dbus.ObjectPath('/NO_MENU'),
            'ItemIsMenu': False,
        }
    
    @dbus.service.signal(ITEM_IFACE)
    def NewIcon(self):
        pass
    
    @dbus.service.signal(ITEM_IFACE)
    def NewToolTip(self):
        pass
    
    @dbus.service.signal(ITEM_IFACE)
    def NewStatus(self, status):
        pass
    
    @dbus.service.method(ITEM_IFACE, in_signature='ii')
    def Activate(self, x, y):
        return
    
    @dbus.service.method(ITEM_IFACE, in_signature='ii')
    def SecondaryActivate(self, x, y):
        pass
    
    @dbus.service.method(ITEM_IFACE, in_signature='is')
    def Scroll(self, delta, orientation):
        pass
    
    @dbus.service.method(ITEM_IFACE, in_signature='ii')
    def ContextMenu(self, x, y):
        pass


def main():
    import time
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    
    ensure_icons()

    session_bus = None
    for attempt in range(30):
        try:
            session_bus = dbus.SessionBus()
            break
        except dbus.DBusException:
            time.sleep(1)
    if session_bus is None:
        sys.exit(1)
    
    bus_name = dbus.service.BusName('org.kde.StatusNotifierItem-kb-indicator', session_bus)
    
    item = StatusNotifierItem(session_bus, '/StatusNotifierItem')
    
    def on_signal(signum, frame):
        item.cleanup()
        sys.exit(0)
    
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    
    loop = GLib.MainLoop()
    loop.run()


if __name__ == '__main__':
    main()
